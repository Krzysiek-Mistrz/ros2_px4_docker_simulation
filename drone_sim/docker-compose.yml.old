services:
  px4:
    build: .
    image: px4-sim-custom:latest
    container_name: ros2_px4_sim
    stdin_open: true
    tty: true
    network_mode: host
    privileged: true
    environment:
      - ROS_DOMAIN_ID=0
      - DISPLAY=${DISPLAY:-:0}
      - QT_X11_NO_MITSHM=1
      - NVIDIA_VISIBLE_DEVICES=all
      - NVIDIA_DRIVER_CAPABILITIES=all
      - XAUTHORITY=${XAUTH:-/tmp/.docker.xauth}
      - XDG_RUNTIME_DIR=/tmp/runtime-root
      - LIBGL_ALWAYS_INDIRECT=0
      - LIBGL_ALWAYS_SOFTWARE=0
    volumes:
      - .:/home/px4/ros2   # <<-- host ./ros2 persists to container /home/px4/ros2
      - /tmp/.X11-unix:/tmp/.X11-unix:rw
      - ${XAUTH:-/tmp/.docker.xauth}:/tmp/.docker.xauth:rw
      - /dev/shm:/dev/shm
    devices:
      - /dev/dri:/dev/dri
      - /dev/bus/usb:/dev/bus/usb  # USB devices for Pixhawk
      - /dev/ttyUSB0:/dev/ttyUSB0
      - /dev/ttyUSB1:/dev/ttyUSB1
      - /dev/ttyACM0:/dev/ttyACM0
      - /dev/ttyACM1:/dev/ttyACM1
    working_dir: /home/px4/ros2 
    restart: unless-stopped
    entrypoint: ["/entrypoint.sh"]
    command: ["bash", "-lc", "tail -f /dev/null"]
    runtime: nvidia